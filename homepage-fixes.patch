+/* Homepage compact partner band (replaces full partner showcase on index) */
+.partner-band { padding:44px 0; background:var(--bg); }
+.partner-band-inner { display:grid; grid-template-columns:auto minmax(0,1fr); gap:36px; align-items:center; padding:26px 28px; border:1px solid var(--line-strong); background:var(--bg-card); }
+.partner-band-logos { display:flex; gap:12px; }
+.partner-band-logos img { width:96px; height:96px; object-fit:contain; background:#fff; padding:10px; display:block; }
+.partner-band-title { font-family:var(--display); font-size:clamp(22px,2.2vw,28px); letter-spacing:.5px; line-height:1.15; color:var(--ink); margin:6px 0 10px; }
+.partner-band-copy p { margin:0; font-size:14px; line-height:1.7; color:var(--ink-dim); }
+.partner-band-links { display:flex; flex-wrap:wrap; gap:8px 22px; margin-top:12px!important; }
+.partner-band-links a { color:var(--blue-glow); font-size:13px; text-underline-offset:3px; }
+@media (max-width:720px) { .partner-band-inner { grid-template-columns:1fr; gap:20px; padding:22px 20px; } .partner-band-logos img { width:80px; height:80px; } }
